{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^(react|next)(.*)$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/(server|lib|types)/(.*)$",
    "",
    "^@/(components|features|stores)/(.*)$",
    "",
    "^[./]"
  ]
}
